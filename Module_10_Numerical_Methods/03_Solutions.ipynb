    "### 1. Floating-Point Machine Epsilon"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "eps = 1.0\n",
    "while 1.0 + eps / 2.0 != 1.0:\n",
    "    eps /= 2.0\n",
    "\n",
    "print(\"Calculated Machine Epsilon:\", eps)\n",
    "print(\"NumPy eps:\", np.finfo(float).eps)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. FP16 Underflow Demonstration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "x = np.array([1e-5], dtype=np.float16)\n",
    "print(\"x in float16:\", x[0])\n",
    "x_squared = x**2\n",
    "print(\"x^2 in float16 (underflow):\", x_squared[0])  # underflows to 0.0\n",
    "print(\"x^2 in float32:\", (x.astype(np.float32))**2)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3. Condition Number Calculation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "A = np.array([[10, 7], [8, 5.99]])\n",
    "cond_l1 = np.linalg.cond(A, p=1)\n",
    "print(\"L1 Condition Number:\", cond_l1)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4. Log-Sum-Exp Derivation\n",
    "$$c + \\log \\sum_{i=1}^n e^{x_i - c} = c + \\log \\sum_{i=1}^n \\frac{e^{x_i}}{e^c}$$\n",
    "$$= c + \\log \\left( \\frac{1}{e^c} \\sum_{i=1}^n e^{x_i} \\right)$$\n",
    "$$= c + \\log(e^{-c}) + \\log \\sum_{i=1}^n e^{x_i}$$\n",
    "$$= c - c + \\log \\sum_{i=1}^n e^{x_i} = \\log \\sum_{i=1}^n e^{x_i}$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mathematical proof verified."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5. Stable Softmax Implementation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def stable_softmax(z):\n",
    "    c = np.max(z)\n",
    "    e_z = np.exp(z - c)\n",
    "    return e_z / np.sum(e_z)\n",
    "\n",
    "print(stable_softmax([1000.0, 1000.0, 1000.0]))\n",
    "print(stable_softmax([-1000.0, -1000.0, -1000.0]))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6. Stable Sigmoid Implementation\n",
    "For highly negative $x$, $e^{-x}$ overflows. We rewrite:\n",
    "- For $x \\ge 0$: $\\sigma(x) = \\frac{1}{1 + e^{-x}}$\n",
    "- For $x < 0$: $\\sigma(x) = \\frac{e^x}{1 + e^x}$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def stable_sigmoid(x):\n",
    "    x = np.array(x, dtype=float)\n",
    "    return np.where(x >= 0, 1 / (1 + np.exp(-x)), np.exp(x) / (1 + np.exp(x)))\n",
    "\n",
    "print(stable_sigmoid([1000.0, -1000.0]))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 7. Simple Linear Congruential Generator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class LCG:\n",
    "    def __init__(self, seed=42, a=1664525, c=1013904223, m=2**32):\n",
    "        self.state = seed\n",
    "        self.a = a\n",
    "        self.c = c\n",
    "        self.m = m\n",
    "        \n",
    "    def next(self):\n",
    "        self.state = (self.a * self.state + self.c) % self.m\n",
    "        return self.state / self.m\n",
    "\n",
    "lcg = LCG()\n",
    "random_numbers = [lcg.next() for _ in range(1000)]\n",
    "print(\"First 5 numbers:\", random_numbers[:5])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8. Power Method for Dominant Eigenvalue"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def power_method(A, num_simulations=100):\n",
    "    b_k = np.random.rand(A.shape[1])\n",
    "    for _ in range(num_simulations):\n",
    "        # calculate the matrix-by-vector product\n",
    "        b_k1 = np.dot(A, b_k)\n",
    "        # renormalize the vector\n",
    "        b_k = b_k1 / np.linalg.norm(b_k1)\n",
    "    \n",
    "    # Rayleigh quotient\n",
    "    eigenvalue = np.dot(b_k, np.dot(A, b_k)) / np.dot(b_k, b_k)\n",
    "    return eigenvalue, b_k\n",
    "\n",
    "A = np.array([[4.0, 1.0], [1.0, 3.0]])\n",
    "eigenval, eigenvector = power_method(A)\n",
    "print(f\"Dominant Eigenvalue: {eigenval:.4f}\")\n",
    "print(f\"Eigenvector: {eigenvector}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 9. Implement Conjugate Gradient from Scratch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def conjugate_gradient(A, b, tol=1e-6, max_iter=100):\n",
    "    x = np.zeros_like(b)\n",
    "    r = b - A @ x\n",
    "    p = r.copy()\n",
    "    rsold = np.dot(r, r)\n",
    "    \n",
    "    for i in range(max_iter):\n",
    "        Ap = A @ p\n",
    "        alpha = rsold / np.dot(p, Ap)\n",
    "        x = x + alpha * p\n",
    "        r = r - alpha * Ap\n",
    "        rsnew = np.dot(r, r)\n",
    "        if np.sqrt(rsnew) < tol:\n",
    "            break\n",
    "        p = r + (rsnew / rsold) * p\n",
    "        rsold = rsnew\n",
    "    return x\n",
    "\n",
    "A = np.array([[4.0, 1.0], [1.0, 3.0]])\n",
    "b = np.array([1.0, 2.0])\n",
    "print(\"CG Solution from scratch:\", conjugate_gradient(A, b))"
   ]
  },
