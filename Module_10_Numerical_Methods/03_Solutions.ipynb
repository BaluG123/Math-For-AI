   "source": [
    "### 15. Newton-Raphson for Logistic Regression MLE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X = np.array([[1.0, 0.5], [1.0, 1.5], [1.0, 2.5], [1.0, 3.5]])\n",
    "y = np.array([0.0, 0.0, 1.0, 1.0])\n",
    "\n",
    "w = np.array([0.0, 0.0])\n",
    "for _ in range(10):\n",
    "    p = 1 / (1 + np.exp(-X @ w))\n",
    "    gradient = X.T @ (p - y)\n",
    "    W_diag = p * (1 - p)\n",
    "    Hessian = X.T @ np.diag(W_diag) @ X\n",
    "    w -= np.linalg.solve(Hessian, gradient)\n",
    "\n",
    "print(\"Fitted Weights (intercept, slope):\", w)"
   ]
  }
