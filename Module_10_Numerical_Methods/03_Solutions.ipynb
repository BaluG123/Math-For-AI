   "source": [
    "### 14. Truncated SVD for Low-Rank Approximation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "A = np.zeros((100, 100))\n",
    "for i in range(100):\n",
    "    for j in range(100):\n",
    "        A[i, j] = np.sin(i / 10.0) + np.cos(j / 10.0)\n",
    "\n",
    "U, S, Vt = np.linalg.svd(A)\n",
    "# Rank 2 approximation\n",
    "A_approx = U[:, :2] @ np.diag(S[:2]) @ Vt[:2, :]\n",
    "error = np.linalg.norm(A - A_approx)\n",
    "print(f\"Reconstruction Error with rank-2 approximation: {error:.6e}\")"
   ]
  },
