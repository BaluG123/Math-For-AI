    "# Numerical verification of Itô's Lemma for V(x) = x^2\n",
    "# By Itô's Lemma, for dx = dW, d(x^2) = (0 + 0 + 1/2 * 1 * 2)dt + 2x dW = dt + 2x dW\n",
    "# Let's verify that E[x_T^2] = T (since E[dW] = 0, E[x_T^2] = E[x_0^2] + T)\n",
    "N = 10000\n",
    "T = 2.0\n",
    "# Sample x_T for N paths\n",
    "x_T = np.random.normal(0, np.sqrt(T), N)\n",
    "print(f\"E[x_T^2]: {np.mean(x_T**2):.4f} (Expected: {T})\")"
   ]
