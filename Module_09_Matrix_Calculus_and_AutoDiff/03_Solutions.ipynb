   "source": [
    "# f(x, y) = x^2 y + y^3\n",
    "# grad_f = [2xy, x^2 + 3y^2]\n",
    "# H = [[2y, 2x], [2x, 6y]]\n",
    "x_val, y_val = 1.0, 2.0\n",
    "v = np.array([1.0, 1.0])\n",
    "\n",
    "H = np.array([[2*y_val, 2*x_val], [2*x_val, 6*y_val]])\n",
    "hvp = H @ v\n",
    "print(\"Hessian-Vector Product (exact):\", hvp)"
   ]
