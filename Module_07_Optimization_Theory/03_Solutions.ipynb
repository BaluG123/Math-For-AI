    "plt.plot(run_gd(0.021), label='lr = 0.021 (Overshooting)')\n",
    "plt.yscale('log')\n",
    "plt.xlabel('Iteration')\n",
    "plt.ylabel('Loss')\n",
    "plt.title('GD Convergence with Different LRs on Ill-Conditioned Problem')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
