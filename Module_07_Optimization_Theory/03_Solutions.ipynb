   "source": [
    "### 15. Line Search Strategies (Backtracking Line Search)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def backtracking_line_search(f, grad_fn, x, d, alpha=0.5, beta=0.8, c=1e-4):\n",
    "    # d is descent direction (e.g. -grad)\n",
    "    g = grad_fn(*x)\n",
    "    val = f(*x)\n",
    "    step = alpha\n",
    "    while f(*(x + step * d)) > val + c * step * np.dot(g, d):\n",
    "        step *= beta\n",
    "    return step\n",
    "\n",
    "f = lambda x, y: (1 - x)**2 + 100 * (y - x**2)**2\n",
    "grad_f = lambda x, y: np.array([-2*(1-x) - 400*x*(y-x**2), 200*(y-x**2)])\n",
    "\n",
    "x = np.array([-1.2, 1.0])\n",
    "d = -grad_f(*x)\n",
    "step_size = backtracking_line_search(f, grad_f, x, d)\n",
    "print(\"Selected Step Size:\", step_size)"
   ]
  }
