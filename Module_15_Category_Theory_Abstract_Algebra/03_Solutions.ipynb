   "metadata": {},
   "source": [
    "### 2. Group Action Orbit"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "theta = np.pi / 2\n",
    "R = np.array([\n",
    "    [np.cos(theta), -np.sin(theta)],\n",
    "    [np.sin(theta), np.cos(theta)]\n",
    "])\n",
    "pt = np.array([1.0, 0.0])\n",
    "rotated_pt = R @ pt\n",
    "print(\"Rotated Point:\", rotated_pt)"
   ]
  },
