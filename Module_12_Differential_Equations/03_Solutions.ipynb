   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 9. Implement a Toy Neural ODE from Scratch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Simple NumPy-based parameter fitting of Neural ODE dy/dt = theta * y\n",
    "# We want to fit y(t=1) = 4 starting from y(0) = 2.\n",
    "theta = 0.1  # initial guess\n",
    "lr = 0.1\n",
    "target = 4.0\n",
    "\n",
    "for epoch in range(20):\n",
    "    # Forward pass: solve ODE\n",
    "    # y(t) = y(0) * e^(theta * t)\n",
    "    y_T = 2.0 * np.exp(theta * 1.0)\n",
    "    loss = (y_T - target)**2\n",
    "    \n",
    "    # Gradient dL/dtheta = dL/dy_T * dy_T/dtheta\n",
    "    dl_dy = 2 * (y_T - target)\n",
    "    dy_dtheta = 2.0 * np.exp(theta) * 1.0\n",
    "    grad = dl_dy * dy_dtheta\n",
    "    \n",
    "    theta -= lr * grad\n",
    "    if epoch % 5 == 0:\n",
    "        print(f\"Epoch {epoch}: theta = {theta:.4f}, Loss = {loss:.4f}, Pred = {y_T:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 10. Score-Based Generative Model: Reverse SDE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Forward noising: dx = -x dt + dw\n",
    "# Reverse denoising: dx = (-x - score) dt + dw\n",
    "# Mock score: score = -x / (1 - exp(-2t))\n",
    "\n",
    "N = 100\n",
    "t_steps = np.linspace(1e-3, 1.0, N)\n",
    "dt = 1.0 / N\n",
    "\n",
    "# Start with noise\n",
    "x = np.random.normal(0, 1)\n",
    "\n",
    "# Simulate backward in time\n",
    "for t in reversed(t_steps):\n",
    "    score = -x / (1.0 - np.exp(-2*t))\n",
    "    drift = -x - 1.0 * score\n",
    "    dw = np.random.normal(0, np.sqrt(dt))\n",
    "    # Backward step\n",
    "    x = x - drift * dt + 1.0 * dw\n",
    "print(\"Denoised/reconstructed value:\", x)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 11. Physics-Informed Neural Network (PINN) Loss Formulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PyTorch-like pseudo-code implementing wave equation loss: u_tt - c^2 u_xx = 0\n",
    "def pinn_wave_loss(model, t, x, c=1.0):\n",
    "    # Assumes t, x are torch.Tensors with requires_grad=True\n",
    "    # u = model(t, x)\n",
    "    # u_t = torch.autograd.grad(u, t, create_graph=True)[0]\n",
    "    # u_tt = torch.autograd.grad(u_t, t, create_graph=True)[0]\n",
    "    # u_x = torch.autograd.grad(u, x, create_graph=True)[0]\n",
    "    # u_xx = torch.autograd.grad(u_x, x, create_graph=True)[0]\n",
    "    # pde_residual = u_tt - (c**2) * u_xx\n",
    "    # return torch.mean(pde_residual**2)\n",
    "    print(\"PINN loss equation: u_tt - (c^2) * u_xx\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 12. Euler-Maruyama Method for SDEs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "N = 500\n",
    "dt = 1.0 / N\n",
    "num_trajectories = 50\n",
    "x = np.ones((num_trajectories, N))\n",
    "\n",
    "for t in range(1, N):\n",
    "    dw = np.random.normal(0, np.sqrt(dt), num_trajectories)\n",
    "    # dx = -x^3 dt + 0.5 dw\n",
    "    x[:, t] = x[:, t-1] - (x[:, t-1]**3) * dt + 0.5 * dw\n",
    "\n",
    "mean = np.mean(x, axis=0)\n",
    "var = np.var(x, axis=0)\n",
    "print(f\"Final mean at T=1: {mean[-1]:.4f}, Final variance: {var[-1]:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 13. Heat Equation Numerical Solution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "nx_points = 50\n",
    "dx = 1.0 / nx_points\n",
    "dt = 0.001\n",
    "alpha = 0.01\n",
    "\n",
    "# FTCS coefficient check (must be <= 0.5 for stability)\n",
    "assert alpha * dt / (dx**2) <= 0.5\n",
    "\n",
    "u = np.zeros(nx_points)\n",
    "u[20:30] = 1.0  # Initial temperature block\n",
    "\n",
    "for t in range(100):\n",
    "    u_next = u.copy()\n",
    "    for i in range(1, nx_points-1):\n",
    "        u_next[i] = u[i] + alpha * dt / (dx**2) * (u[i+1] - 2*u[i] + u[i-1])\n",
    "    u = u_next\n",
    "\n",
    "print(\"Temperature distribution after 100 steps:\")\n",
    "print(\"Max temp:\", np.max(u))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 14. Continuous-Time Normalizing Flows\n",
    "In a Continuous Normalizing Flow (CNF), a probability density $p(\\mathbf{h}(t))$ is evolved via a vector field $\\frac{d\\mathbf{h}}{dt} = f(\\mathbf{h}(t), t, \\theta)$.\n",
    "The change in the log-probability density is given by the instantaneous change of variables formula:\n",
    "$$\\frac{d \\log p(\\mathbf{h}(t))}{dt} = -\\text{tr}\\left( \\frac{\\partial f(\\mathbf{h}(t), t, \\theta)}{\\partial \\mathbf{h}} \\right)$$\n",
    "Calculating the exact trace of the Jacobian is expensive ($O(D^2)$), so CNFs use **Hutchinson's trace estimator** to approximate the trace with $O(D)$ complexity using random vectors $\\mathbf\n",
    "{v}$:\n",
    "$$\\text{tr}(J) = \\mathbb{E}_{\\mathbf{v}} [\\mathbf{v}^T J \\mathbf{v}]$$"
   ]
  },
